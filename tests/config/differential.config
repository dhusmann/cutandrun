params {
    outdir = "results/"
    publish_dir_mode = "copy"
    singularity_pull_docker_container = false
}

process {
    cpus = 2
    memory = 6.GB
    time = 6.h
}

singularity.enabled = true
singularity.autoMounts = true
conda.enabled = true
conda.channels = ['conda-forge', 'bioconda', 'defaults']

process {
    withName: '.*DIFFBIND_RUN' {
        ext.when = false
    }
}
